# Copy to .env.local for development. Real environment variables always win.

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
# Public URL of the app. Sign-in redirect URIs are built from it, and the server rejects
# requests from any other address, so it must match the address in your browser.
# Using Docker Compose? It serves the app on port 8080: set BASE_URL=http://localhost:8080
# (PORT and DATABASE_URL below are then set by compose and ignored).
BASE_URL=http://localhost:3000
# "production" requires an https BASE_URL, DATABASE_URL and LEGAL_CONTACT_EMAIL.
APP_ENV=development
# true behind a reverse proxy or tunnel, so rate limits see the visitor's IP.
TRUST_PROXY=false

# ── Database ────────────────────────────────────────────────────────
# Leave empty in development: an embedded Postgres is downloaded into ./.data.
# Production: postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=

# ── Encryption ──────────────────────────────────────────────────────
# Master keys that wrap each user's data key. Keep them outside the database and its
# backups (a secret manager or your host's secrets). Required in production.
# Format: version:base64key, comma-separated. Generate a key with: openssl rand -base64 32
# To rotate, add a higher version in front (2:new,1:old) and restart: keys are re-wrapped
# with the newest version at startup, after which the old entry can be removed.
# Development: leave empty and a key is created in DATA_DIR/encryption.key.
ENCRYPTION_KEYS=

# ── Sign-in (set at least one; a button appears for each) ───────────
# Google redirect URI: {BASE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Okta redirect URI:   {BASE_URL}/api/auth/callback/okta
AUTH_OKTA_ID=
AUTH_OKTA_SECRET=
AUTH_OKTA_ISSUER=
# Also request the user's birthday from Google (a sensitive scope; see docs/legal-checklist.md).
AUTH_GOOGLE_BIRTHDAY=false
# Local development only: allows signing in at /api/auth/dev without OAuth.
# Refused unless BASE_URL is http://localhost or http://127.0.0.1.
DEV_LOGIN=false

# ── AI model ────────────────────────────────────────────────────────
# Without a model the app runs, but adding documents and building journeys are disabled.
# Set ONE default model with LLM_*. Every tool uses it unless overridden below.
#
# Option A: Anthropic Claude
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5        # default; claude-sonnet-5-5 or claude-opus-5-5 for more depth
#
# Option B: any OpenAI-compatible API (OpenAI, OpenRouter, Ollama, DeepSeek, Groq, vLLM, ...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# LLM_API_KEY=                      # not needed for a local server such as Ollama
# LLM_STRUCTURED=json_schema        # json_schema | json_object | prompt: how the API returns JSON
# LLM_VISION=false                  # true if the model reads images (enables OCR of PDFs)
# LLM_NATIVE_PDF=false              # true if the API accepts PDF files directly
# LLM_MAX_TOKENS=8192               # output limit; reasoning models need more (e.g. 32000)
#
# Shown to users before they send anything:
# LLM_DISPLAY_NAME=                 # defaults to a readable form of LLM_MODEL
# LLM_PRIVACY=                      # secure | not_secure. Default: secure for Claude and for models on
#                                   # localhost, not_secure for other hosted APIs. Read your provider's
#                                   # data terms before setting secure.
#
# Tuning:
# LLM_CONCURRENCY=4                 # parallel calls while building a journey (1 for a local model)
# LLM_BATCH_SIZE=3                  # journey nodes written per call (larger = fewer calls)
# LLM_RESUME_MODE=auto              # auto (text + OCR, cross-checked) | text | vision
# ANTHROPIC_EFFORT=                 # low | medium | high | off (Claude 5 models)

# ── Per-tool models (optional) ──────────────────────────────────────
# Override any LLM_* setting for one tool by adding a prefix. Anything not set is inherited
# from the default. A different provider or base URL never inherits the default's API key.
#
# Document reader (resumes, documents, links): DOCS_LLM_*
# DOCS_LLM_MODEL=
# DOCS_LLM_VISION=true
#
# Job analysis and journeys: JOURNEY_LLM_*
# JOURNEY_LLM_PROVIDER=anthropic
# JOURNEY_LLM_MODEL=claude-sonnet-5-5

# ── Limits ──────────────────────────────────────────────────────────
# Journeys a user can start per 24 hours.
GENERATION_DAILY_LIMIT=3

# ── Legal (fills the Terms of Service and Privacy Policy) ───────────
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
LEGAL_HOSTING=
LEGAL_JURISDICTION=Singapore
LEGAL_MIN_AGE=18
